{
  "name": "pcbprinter",
  "version": "0.2.2",
  "description": "Convert Fritzing PCB SVG exports to 3D-printable STL files",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pcbprinter": "./dist/cli.js"
  },
  "scripts": {
    "release": "bash scripts/release.sh",
    "build": "tsc",
    "build:browser": "node scripts/build-browser.mjs",
    "build:bundle": "node scripts/build-bundle.mjs",
    "build:binary": "npm run build && npm run build:bundle && pkg dist/cli.bundled.cjs --targets node18-macos-x64,node18-linux-x64,node18-win-x64 --output dist/pcbprinter",
    "dev": "ts-node --esm src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@jscad/modeling": "^2.11.0",
    "@jscad/stl-serializer": "^2.1.23",
    "@xmldom/xmldom": "^0.8.10",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "manifold-3d": "^3.3.2",
    "opentype.js": "^1.3.4",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/opentype.js": "^1.3.9",
    "esbuild": "^0.24.2",
    "pkg": "^5.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
